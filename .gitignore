# ============================================================
# 六级词卡 - Git 忽略规则
# 目的：仓库只保留源码，不上传编译产物、大文件和敏感证书
# ============================================================

# 编译产物与安装包（体积大、每次打包都变；APK 请放 GitHub Releases）
unpackage/

# 依赖目录
node_modules/
dist/

# HBuilderX 本地运行配置（含本机路径）
.hbuilderx/

# 【安全】签名证书与密钥 —— 绝对不能提交到任何仓库
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.keystore.*
signing/

# 系统与编辑器临时文件
.DS_Store
Thumbs.db
*.log
*.swp
*.tmp
*.suo
.idea/
.vscode/
